{
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/generate-matches",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/match-reminder",
      "schedule": "0 1 * * *"
    }
  ]
}
