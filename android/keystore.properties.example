# 릴리스 서명 설정 예시.
# 이 파일을 android/keystore.properties 로 복사한 뒤 실제 값으로 채운다.
# keystore.properties 는 gitignore되어 커밋되지 않는다.
#
# storeFile: 키스토어 절대 경로 (역슬래시는 이스케이프: C\:\\tenol-key\\tenol-release.jks)
storeFile=C\:\\tenol-key\\tenol-release.jks
storePassword=여기에_키스토어_비밀번호
keyAlias=여기에_키_별칭
keyPassword=여기에_키_비밀번호
