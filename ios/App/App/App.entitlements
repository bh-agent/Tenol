<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 푸시 알림(APNs). archive(배포) 시 Xcode가 production으로 자동 승격함. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links: /.well-known/apple-app-site-association (Team U73UP8WL5G). Xcode > Signing & Capabilities에 Associated Domains가 켜져 있어야 함 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tenol-one.vercel.app</string>
	</array>
</dict>
</plist>
